# ============================================================================
# GC MoE EP8 + EPLB(10%) — experiment configuration
#
# Every value is a DEFAULT: override from the shell before calling run_arm.sh
#   SEQS_PER_RANK=32 WARM_STEPS=100 MEASURE_STEPS=100 ./scripts/run_arm.sh 1 x
# ============================================================================

# --- model / data -----------------------------------------------------------
export MODEL=${MODEL:-$MODEL_DIR}
export DATASET=${DATASET:-$DATASET_DIR/dsv4-flash_online_input_ids_26-10-08_1.jsonl,$DATASET_DIR/dsv4-flash_online_input_ids_26-10-08_2.jsonl}
export PREFILL_LO=${PREFILL_LO:-256}
export PREFILL_HI=${PREFILL_HI:-2048}

# --- parallelism ------------------------------------------------------------
export WORLD=${WORLD:-8}                 # TP=8, EP=8, DP=1
export MOE_BACKEND=${MOE_BACKEND:-gc_moe}
export ALL2ALL_BACKEND=${ALL2ALL_BACKEND:-allgather_reducescatter}
export GC_MOE_SM90_DISPATCH_SMS=${GC_MOE_SM90_DISPATCH_SMS:-4}

# --- memory -----------------------------------------------------------------
export GPU_UTIL=${GPU_UTIL:-0.85}
export MAX_BATCHED=${MAX_BATCHED:-2048}       # --max-num-batched-tokens
export GC_MOE_CAPACITY=${GC_MOE_CAPACITY:-2048}   # compile-time kernel geometry
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
export VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD=${VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD:-0}

# --- EPLB -------------------------------------------------------------------
export GC_MOE_EPLB=${GC_MOE_EPLB:-0}                    # set by run_arm.sh arg
export GC_MOE_EPLB_REDUNDANCY=${GC_MOE_EPLB_REDUNDANCY:-0.10}
# Set by scripts/run_arm.sh: EPLB arm re-plans by default, vanilla never does.
export GC_MOE_EPLB_NO_REARRANGE=${GC_MOE_EPLB_NO_REARRANGE:-0}

# --- ECO (SM90 online split plan, role 5) -----------------------------------
# [ECO-SM90] ECO replaces the host round-robin slot choice of the EPLB arm with
# the in-kernel plan. It needs EPLB placement (copies to split over).
export GC_MOE_ECO=${GC_MOE_ECO:-0}
# Rank-time weights. Tokens weigh 1; wb = one extra M-block, wa = one extra
# active slot. SM100's fitted (wb, wa) are B300 values and must not be copied;
# `wb = bm, wa = 0` is the token-dominant objective and is exact while
# count <= block M (then "blocks" == "active slots").
export GC_MOE_ECO_WB=${GC_MOE_ECO_WB:-0}
export GC_MOE_ECO_WA=${GC_MOE_ECO_WA:-0}
export GC_MOE_ECO_ROUNDS=${GC_MOE_ECO_ROUNDS:-1}
export GC_MOE_ECO_COLD_ROUNDS=${GC_MOE_ECO_COLD_ROUNDS:-6}
# Must be >= the largest replica count the EPLB policy produces (a 2x hot
# expert gives 3 copies; a 10x one gives 12).
# [ECO-SM90] Must be >= the largest copy count the placement produces. With
# 25% redundancy the hot expert reached 5-6 copies, so 4 silently dropped
# copies (nothing pulled their tokens). EcoMeta holds 32 int16 per expert.
export GC_MOE_ECO_MAX_COPIES=${GC_MOE_ECO_MAX_COPIES:-8}

# --- measurement protocol ---------------------------------------------------
export SEQS_PER_RANK=${SEQS_PER_RANK:-4}   # 4/rank = 32 sequences (smoke)
export WARM_STEPS=${WARM_STEPS:-5}
export MEASURE_STEPS=${MEASURE_STEPS:-10}
export GC_PREFILL_MARGIN=${GC_PREFILL_MARGIN:-256}
export GC_MEASURE_FLUSH=${GC_MEASURE_FLUSH:-5}
# --- latest switches (2026-11-19) -------------------------------------------
# [MB-CLAIM] one ticket per (expert, ntile, M-block) instead of per (expert,
# ntile). Removes the tail where one CTA serialised all of a tile's M blocks.
# Measured on BS256/ECO: ms 62.39 -> 58.59 (-6.1%), tokens identical.
# DEFAULT 0 = historical tile-granularity claim; set 1 for the faster path.
export GC_MOE_MB_CLAIM=${GC_MOE_MB_CLAIM:-0}

# [PER-LAYER EPLB] one placement row per MoE layer (DeepInfer semantics).
# Leaving this at 0 makes all 40 layers share one placement -> half the layers
# get a neighbour's map and per-layer IR swings 1.1 / 2.0.
export GC_MOE_ECOPLB_PER_LAYER=${GC_MOE_ECOPLB_PER_LAYER:-1}
export GC_MOE_ECO_PER_LAYER=${GC_MOE_ECO_PER_LAYER:-1}

# [EPLB] redundant slots PER RANK (overrides the fractional REDUNDANCY knob).
# 8/rank = physical 448 (56 slots/rank) with 384 logical experts.
export GC_MOE_EPLB_EXTRA_PER_RANK=${GC_MOE_EPLB_EXTRA_PER_RANK:-8}

# [PULL-TRACE] in-kernel phase stamps: pull_tl[epoch][3]/[5]/[10]/[15] ...
# Required for the 7-phase timeline (count exchange / pull / wait token).
export GC_MOE_PULL_TRACE=${GC_MOE_PULL_TRACE:-0}
# [ECO-TRACE] ECO plan timeline + T[r] prediction export (pull_tl[24..31]).
export GC_MOE_ECO_TRACE=${GC_MOE_ECO_TRACE:-0}
# [IR-STEP] per (layer, step) token / M-block / active-slot tables.
export GC_MOE_IR_STEP=${GC_MOE_IR_STEP:-0}
export GC_MEASURE_IR_STEP=${GC_MEASURE_IR_STEP:-1}
export GC_IRSTEP_STEPS=${GC_IRSTEP_STEPS:-1024}
export GC_MOE_LAYERS=${GC_MOE_LAYERS:-40}

# [COST-FN] measured-table cost function. DEFAULT OFF: it was 8/8 worse
# (docs/COSTFN_RESULT.md). Keep wb/wa as the main path.
export GC_MOE_ECO_COSTFN=${GC_MOE_ECO_COSTFN:-0}
# [SM-REUSE] role 6 reuses the 6 SMs dispatch releases.
export GC_MOE_SM90_SM_REUSE=${GC_MOE_SM90_SM_REUSE:-0}
# [SHARED-IN-GC] 0 = vLLM computes the shared expert (production default;
# gc_moe then launches 4 kernels). 1 = gc_moe role 4 owns it (5 kernels).
export GC_MOE_SHARED_IN_GC=${GC_MOE_SHARED_IN_GC:-0}

