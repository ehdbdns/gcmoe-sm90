# ============================================================================
# GC MoE EP8 + EPLB(10%) — experiment configuration
#
# Every value is a DEFAULT: override from the shell before calling run_arm.sh
#   SEQS_PER_RANK=32 WARM_STEPS=100 MEASURE_STEPS=100 ./scripts/run_arm.sh 1 x
# ============================================================================

# --- model / data -----------------------------------------------------------
export MODEL=${MODEL:-/mnt/nas2/models/DeepSeek-V4.1-Flash}
export DATASET=${DATASET:-/mnt/nas2/nanjun.cp/MoE-Bench-Experiments/datasets/dsv4-flash_online_input_ids_26-10-08_1.jsonl,/mnt/nas2/nanjun.cp/MoE-Bench-Experiments/datasets/dsv4-flash_online_input_ids_26-10-08_2.jsonl}
export PREFILL_LO=${PREFILL_LO:-256}
export PREFILL_HI=${PREFILL_HI:-2048}

# --- parallelism ------------------------------------------------------------
export WORLD=${WORLD:-8}                 # TP=8, EP=8, DP=1
export MOE_BACKEND=${MOE_BACKEND:-gc_moe}
export ALL2ALL_BACKEND=${ALL2ALL_BACKEND:-allgather_reducescatter}
export GC_MOE_SM90_DISPATCH_SMS=${GC_MOE_SM90_DISPATCH_SMS:-4}

# --- memory -----------------------------------------------------------------
export GPU_UTIL=${GPU_UTIL:-0.85}
export MAX_BATCHED=${MAX_BATCHED:-2048}       # --max-num-batched-tokens
export GC_MOE_CAPACITY=${GC_MOE_CAPACITY:-2048}   # compile-time kernel geometry
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
export VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD=${VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD:-0}

# --- EPLB -------------------------------------------------------------------
export GC_MOE_EPLB=${GC_MOE_EPLB:-0}                    # set by run_arm.sh arg
export GC_MOE_EPLB_REDUNDANCY=${GC_MOE_EPLB_REDUNDANCY:-0.10}
# Set by scripts/run_arm.sh: EPLB arm re-plans by default, vanilla never does.
export GC_MOE_EPLB_NO_REARRANGE=${GC_MOE_EPLB_NO_REARRANGE:-0}

# --- ECO (SM90 online split plan, role 5) -----------------------------------
# [ECO-SM90] ECO replaces the host round-robin slot choice of the EPLB arm with
# the in-kernel plan. It needs EPLB placement (copies to split over).
export GC_MOE_ECO=${GC_MOE_ECO:-0}
# Rank-time weights. Tokens weigh 1; wb = one extra M-block, wa = one extra
# active slot. SM100's fitted (wb, wa) are B300 values and must not be copied;
# `wb = bm, wa = 0` is the token-dominant objective and is exact while
# count <= block M (then "blocks" == "active slots").
export GC_MOE_ECO_WB=${GC_MOE_ECO_WB:-0}
export GC_MOE_ECO_WA=${GC_MOE_ECO_WA:-0}
export GC_MOE_ECO_ROUNDS=${GC_MOE_ECO_ROUNDS:-1}
export GC_MOE_ECO_COLD_ROUNDS=${GC_MOE_ECO_COLD_ROUNDS:-6}
# Must be >= the largest replica count the EPLB policy produces (a 2x hot
# expert gives 3 copies; a 10x one gives 12).
export GC_MOE_ECO_MAX_COPIES=${GC_MOE_ECO_MAX_COPIES:-4}

# --- measurement protocol ---------------------------------------------------
export SEQS_PER_RANK=${SEQS_PER_RANK:-4}   # 4/rank = 32 sequences (smoke)
export WARM_STEPS=${WARM_STEPS:-5}
export MEASURE_STEPS=${MEASURE_STEPS:-10}
export GC_PREFILL_MARGIN=${GC_PREFILL_MARGIN:-256}
export GC_MEASURE_FLUSH=${GC_MEASURE_FLUSH:-5}
