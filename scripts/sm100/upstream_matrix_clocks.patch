@@ -162,0 +163,8 @@ def sync_weight(*, loc=None, ip=None):
+
+
+@dsl_user_op
+def read_globaltimer(*, loc=None, ip=None) -> Uint64:
+    """Device-wide nanosecond timer (ECO timeline trace)."""
+    return Uint64(llvm.inline_asm(T.i64(), [], 'mov.u64 $0, %globaltimer;', '=l',
