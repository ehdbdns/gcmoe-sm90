+        t0 = self.rank_time(q0)
+        for e, (u, own) in keep.items():
+            cs = self.copies[e]
+            u = list(u)
+            delta = int(self.k[e]) - sum(u)
+            add = [0] * len(cs)
+            while delta > 0:
+                j = min(range(len(cs)), key=lambda j: (int(t0[self.rank[cs[j]]]) + add[j] * unit, j))
+                u[j] += 1; add[j] += 1; delta -= 1
