+        drop = set()   # a transit slot that also makes its own offer: the lower (-source time, s0) one is dropped
+        own = {o[2]: o for o in offers}
+        for x, kw in win2.items():
+            if x in own:
+                drop.add(('own', x) if kw < ck(own[x]) else ('transit', x))
