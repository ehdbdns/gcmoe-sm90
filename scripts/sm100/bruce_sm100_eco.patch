+        ck = lambda o: (o[1][0], o[2])   # (-source time, s0)
+        win2 = {}   # per transit slot: the two-hop offer with the min (-source time, s0)
+        for o in offers:
+            if o[4][5] is not None and (o[4][5][0] not in win2 or ck(o) < win2[o[4][5][0]]):
