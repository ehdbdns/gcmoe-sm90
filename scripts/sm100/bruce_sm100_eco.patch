index 0000000..d5ca64e
--- /dev/null
+++ b/gc_moe/eco/measurement.py
@@ -0,0 +1,60 @@
+"""Per-call device trace storage. Capture snapshot() after a sampled MoE call."""
+import os
+import torch
+
+from ..layout.gc_moe import align, ECO_SIGNAL_OFFSETS
+
+# Nanosecond clocks: issue/end pairs indexed by GCBlockPhase (1..4).
+CLOCKS = ("dispatch", "compute", "pull_first", "pull_last",
+          "routed_l1_first", "routed_l1_last", "routed_l2_first", "routed_l2_last",
+          "shared_l1_first", "shared_l1_last", "shared_l2_first", "shared_l2_last",
+          "combine_first", "combine_last", "wait_first", "plan_first", "plan_last",
+          "accepted", "offered", "score", "events")
+MIN_FIELDS = (0, 1, 2, 4, 6, 8, 10, 12, 14, 15)
+HEADER = 24
+EVENT_WORDS = 12  # uint32: time[2], kind, CTA, warp, sequence, expert, m, n, valid, SM, reserved
+
+
+def configure(buf, base):
+    level = int(os.environ.get("GC_MOE_SM100_TRACE", "0"))
+    if level not in (0, 1, 2):
+        raise ValueError("GC_MOE_SM100_TRACE must be 0 (off), 1 (summary), or 2 (absolute)")
+    slots = buf.num_experts // buf.group.size()
+    buf.trace_level = level
+    buf.trace_offset = align(buf.layout.nbytes, 16)
+    buf.trace_capacity = int(os.environ.get("GC_MOE_SM100_TRACE_EVENTS", "65536")) if level == 2 else 0
+    if level == 2 and not 0 < buf.trace_capacity <= 2147483647 // EVENT_WORDS:
+        raise ValueError("invalid absolute trace capacity")
+    if base is not None and (level, buf.trace_capacity) != (base.trace_level, base.trace_capacity):
+        raise ValueError("trace settings must match the shared base allocation")
+    if not level:
+        return buf.layout.nbytes
+    records = align(slots, 4) * 4 + HEADER * 8 + buf.trace_capacity * EVENT_WORDS * 4
+    return buf.trace_offset + records
+
+
+def setup(buf):
+    if buf.trace_level:
+        slots = buf.num_experts // buf.group.size()
+        size = HEADER * 8 + align(slots, 4) * 4
+        buf.trace_header = buf.buffer.narrow(0, buf.trace_offset, size)
+        buf.trace_template = torch.zeros_like(buf.trace_header)
+        buf.trace_template[:HEADER * 8].view(torch.int64)[list(MIN_FIELDS)] = -1
+
+
+def snapshot(buf):
+    """Graph-capturable copies. Read these after replay, before reusing their graph."""
+    if not buf.trace_level:
+        raise ValueError("trace disabled at buffer allocation")
+    slots = buf.num_experts // buf.group.size()
+    clocks = buf.trace_header[:HEADER * 8].view(torch.int64)[:len(CLOCKS)].clone()
+    counts = buf.trace_header[HEADER * 8:].view(torch.int32)[:slots].clone()
+    out = dict(clocks=clocks, counts=counts)
+    if buf.layout.eco:
+        quota = buf.layout.eco_base + ECO_SIGNAL_OFFSETS["eco_quota"] + buf.rank_idx * slots * 4
+        out["quota"] = buf.buffer.narrow(0, quota, slots * 4).view(torch.int32).clone()
+    if buf.trace_capacity:
+        start = buf.trace_offset + buf.trace_header.numel()
+        out["events"] = buf.buffer.narrow(0, start, buf.trace_capacity * EVENT_WORDS * 4).view(
+            torch.int32).reshape(-1, EVENT_WORDS).clone()
+    return out
diff --git a/gc_moe/eco/plan.py b/gc_moe/eco/plan.py
new file mode 100644
index 0000000..7b27760
--- /dev/null
+++ b/gc_moe/eco/plan.py
@@ -0,0 +1,129 @@
+"""ECO plan role (role 4): nvcc-compiled CUDA C++ cubin, cached by configuration and source hash."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import subprocess
+import tempfile
+from functools import lru_cache
+
+from ..layout.gc_moe import ECO_SIGNAL_OFFSETS, SIGNAL_OFFSETS
+
+ECO_PLAN_ROLE = 4
+# Plan role build (`eco_unit_kernel.cu`): 16 plan warps + 2 index warps
+ECO_UNIT_THREADS = 576
+
+
+# Rank-time weights (block wb, active slot wa; a token weighs 1) per gc-moe block M, fitted on gc-moe kernel times
+# (`gcbench/fit_cost_bm.py`); other block sizes take the nearest entry.
+ECO_TIME_WEIGHTS = {16: (249, 140), 32: (272, 117), 64: (260, 111), 96: (335, 38), 128: (293, 52)}
+
+
+def eco_unit_config(num_ranks: int, block_m: int, extra_slots: int = 0) -> tuple:
+    """Plan role build for an EP size and the call's block M (gc-moe's choice; the plan unit): (block M, block weight
+    wb, active-slot weight wa, warm auction rounds, cold auction rounds, two-hop rounds). The planner minimizes the
+    slowest rank's time wb * blocks + wa * active slots + tokens; GC_MOE_ECO_OBJECTIVE=token balances the tokens alone
+    (wb = wa = 0, two rounds up to EP16). Dense rank graphs (<= 32 ranks) need one-hop rounds only; EP64 starts with
+    two two-hop rounds, then scales warm rounds down with the replica slots per rank (`extra_slots`): each round's
+    cost grows with the relief-pair table while the dispatch warps need the plan at a fixed point (~34us into a
+    128-token call), so rounds must fit that window. GC_MOE_ECO_UNIT_CFG overrides (wb, wa, warm rounds, cold
+    rounds, two-hop rounds)."""
+    if os.environ.get('GC_MOE_ECO_UNIT_CFG'):
+        return (block_m,) + tuple(int(x) for x in os.environ['GC_MOE_ECO_UNIT_CFG'].split(','))
+    token = os.environ.get('GC_MOE_ECO_OBJECTIVE', 'time') == 'token'
+    wb, wa = (0, 0) if token else ECO_TIME_WEIGHTS[min(ECO_TIME_WEIGHTS, key=lambda b: (abs(b - block_m), b))]
+    nr, hop2 = (1 + token, 0) if num_ranks <= 16 else (2, 0) if num_ranks <= 32 else (
+        (3, 2) if extra_slots <= num_ranks else (2, 2) if extra_slots <= 3 * num_ranks else (1, 2))
+    return (block_m, wb, wa, nr, 6, hop2)
+# Timeline trace slots (globaltimer ns, GC_MOE_ECO_TRACE=1): mode store / min / max
+ECO_TRACE_SLOTS = {
+    0: ('role1_start', 'min'), 1: ('role1_barrier_done', 'store'), 2: ('role1_counts_ready', 'store'),
+    3: ('plan_start', 'store'), 4: ('plan_counts_seen', 'store'), 5: ('plan_published', 'store'),
+    6: ('role1_plan_wait_first', 'min'), 7: ('role1_plan_seen_last', 'max'), 8: ('role1_end', 'max'),
+    9: ('role2_sched_start', 'min'), 10: ('role2_counts_seen', 'min'), 11: ('role2_plan_wait_first', 'min'),
+    12: ('role2_plan_seen_last', 'max'), 13: ('role2_sched_end', 'max'), 14: ('role3_start', 'min'),
+    15: ('role3_end', 'max'), 16: ('role2_end', 'max'),
+    # plan role: start done, auction rounds done, replicated indices written
+    17: ('plan_start_done', 'store'), 18: ('plan_rounds_done', 'store'), 19: ('plan_index_done', 'store'),
+    # Graph-replay accumulators (sums over calls of `t - role1 start` of the call; 21: call count, 24: start)
+    20: ('acc_barrier_done', 'sum'), 21: ('acc_calls', 'sum'), 22: ('acc_role3_start', 'sum'),
+    23: ('acc_role3_end_b0', 'sum'), 24: ('role1_start_b0', 'store'), 25: ('acc_plan_published', 'sum'),
+    26: ('acc_role2_plan_stall', 'sum'), 27: ('acc_role1_plan_stall', 'sum'), 28: ('acc_role2_stalls', 'sum'),
+    29: ('acc_role1_stalls', 'sum'),
+    # role1 phase decomposition: counting done / source-index writes done (max over dispatch warps),
+    # counts_ready seen by role1 block0
+    30: ('r1_counted', 'max'), 31: ('r1_srcwrote', 'max'), 32: ('r1_counts_seen', 'store'),
+}
+_SOURCE_DIR = os.path.dirname(os.path.abspath(__file__))
+_SOURCES = ('eco_unit_kernel.cu', 'eco_unit_auction.cuh', 'include/eco_meta.cuh', 'include/eco_compat.cuh')
+
+
+def _nvcc() -> str:
+    return os.environ.get('GC_MOE_NVCC', '/usr/local/cuda/bin/nvcc')
+
+
+def _cache_dir() -> str:
+    path = os.environ.get('GC_MOE_ECO_CACHE_DIR',
+                          os.path.join(os.path.expanduser('~'), '.cache', 'gc_moe', 'eco'))
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def _source_digest() -> str:
+    digest = hashlib.sha256()
+    for name in _SOURCES:
+        with open(os.path.join(_SOURCE_DIR, name), 'rb') as f:
+            digest.update(f.read())
+    return digest.hexdigest()
+
+
+@lru_cache(maxsize=64)
+def compile_eco_plan(num_physical: int, num_ranks: int, num_logical: int, eco_base: int,
+                     topk_offset: int, topk: int, capacity: int, unit: tuple,
+                     arch: str = 'sm_103a', trace: bool = False, measurement_offset: int = 0) -> bytes:
+    """Cubin of the plan role (`eco_unit_kernel.cu`, ECO_UNIT_THREADS threads) for one (P, R, E) configuration,
+    buffer layout (`eco_base`: the buffer's ECO region, `GCBufferLayout.eco_base`) and `unit` build (see
+    `eco_unit_config`)."""
+    if num_logical % 2 or num_physical % num_ranks or num_ranks > 64 or num_physical > 2048:
+        raise ValueError('ECO plan needs an even logical expert count, equal ranks <= 64 and <= 2048 slots')
+    defines = {
+        'ECO_P': num_physical, 'ECO_R': num_ranks, 'ECO_E': num_logical,
+        'ECO_THREADS': ECO_UNIT_THREADS,
+        'OFF_EPOCH': SIGNAL_OFFSETS['recv_parity'],
+        'OFF_ECO_COUNTS_READY': eco_base + ECO_SIGNAL_OFFSETS['eco_counts_ready'],
+        'OFF_ECO_SLOT_COUNT': eco_base + ECO_SIGNAL_OFFSETS['eco_slot_count'],
+        'OFF_ECO_NUM_FIXED': eco_base + ECO_SIGNAL_OFFSETS['eco_num_fixed'],
+        'OFF_ECO_REPS_READY': eco_base + ECO_SIGNAL_OFFSETS['eco_reps_ready'],
+        'OFF_SOURCE_IDX': SIGNAL_OFFSETS['size'],
+        'OFF_TOPK': topk_offset, 'ECO_TOPK': topk, 'ECO_CAPACITY': capacity,
+        'OFF_ECO_PLAN_READY': eco_base + ECO_SIGNAL_OFFSETS['eco_plan_ready'],
+        'OFF_ECO_QUOTA': eco_base + ECO_SIGNAL_OFFSETS['eco_quota'],
+        'OFF_ECO_QUOTA_START': eco_base + ECO_SIGNAL_OFFSETS['eco_quota_start'],
+        'OFF_ECO_COUNTS': eco_base + ECO_SIGNAL_OFFSETS['eco_counts'],
+        'OFF_ECO_TRACE': eco_base + ECO_SIGNAL_OFFSETS['eco_trace'],
+        'OFF_ECO_TRACE_RING': eco_base + ECO_SIGNAL_OFFSETS['eco_trace_ring'],
+        'ECO_TRACE': int(trace),
+        'OFF_MEASUREMENT': measurement_offset,
+    }
+    defines.update(zip(('UNIT_BM', 'UNIT_WB', 'UNIT_WA', 'UNIT_NR', 'UNIT_NRC', 'UNIT_HOP2'), unit))
+    flags = [f'-D{k}={v}u' if k.startswith('OFF_') else f'-D{k}={v}' for k, v in sorted(defines.items())]
+    key = hashlib.sha256((_source_digest() + ' '.join(flags) + arch).encode()).hexdigest()[:32]
+    path = os.path.join(_cache_dir(), f'eco_plan_{key}.cubin')
+    if not os.path.exists(path):
+        # Temporary file in the cache directory: the rename stays on one filesystem (atomic)
+        fd, out = tempfile.mkstemp(suffix='.cubin', dir=os.path.dirname(path))
+        os.close(fd)
+        try:
+            cmd = [_nvcc(), '-cubin', '-std=c++17', '-O3', f'-arch={arch}', '-lineinfo', *flags,
+                   os.path.join(_SOURCE_DIR, 'eco_unit_kernel.cu'),
+                   '-o', out]
+            result = subprocess.run(cmd, capture_output=True, text=True)
+            if result.returncode != 0:
+                raise RuntimeError(f'ECO plan compilation failed:\n{" ".join(cmd)}\n{result.stderr}')
+            os.replace(out, path)
+        finally:
+            if os.path.exists(out):
+                os.remove(out)
+    with open(path, 'rb') as f:
+        return f.read()
diff --git a/gc_moe/eco/unit_ref.py b/gc_moe/eco/unit_ref.py
new file mode 100644
index 0000000..a94bfe0
--- /dev/null
+++ b/gc_moe/eco/unit_ref.py
@@ -0,0 +1,308 @@
+"""Bit-exact numpy reference of the ECO plan role (`eco_unit_kernel.cu`).
+
+Units: an expert's n tokens are k = ceil(n / bm) units, k - 1 full ones of bm tokens and a last partial one.
+Rank time t_r = wb * blocks + wa * active slots + tokens over the rank's slots (wb = wa = 0: tokens alone); the plan
+minimizes the slowest rank's time. One plan:
+  1. start: warm, the previous plan's units per copy (partial owner: the first copy whose quota is congruent to the
+     previous partial size); only experts whose unit count changed add units (copy with the lowest estimated rank time
+     + this expert's additions) or remove units (highest first among copies holding one); the partial stays with its
+     owner while it holds a unit, else goes to the holding copy on the highest-time rank. All experts decide against
+     one rank-time estimate (kept units, new partial sizes). Cold: an even split, load-aware rounding to units.
+  2. auction rounds: every rank above the mean offers, per replicated slot, its best one-hop unit move (or two-hop
+     path through another rank's best outgoing unit, first `hop2_rounds` rounds) below its own time, up to its excess
+     over the mean; receivers accept a prefix (higher source time first) while staying below the source's time and
+     the mean + slack. Stops early when no move is accepted.
+A copy is passive (never planned) when a lower copy of the same expert sits on the same rank."""
+
+from __future__ import annotations
+
+import numpy as np
+
+
+class UnitPlanner:
+    def __init__(self, phy, num_ranks: int, num_logical: int, block_m: int = 64, wb: int = 320, wa: int = 54,
+                 rounds: int = 1, cold_rounds: int = 6, hop2_rounds: int = 0):
+        phy = np.asarray(phy, np.int64)
+        self.phy, self.P, self.R, self.E = phy, len(phy), num_ranks, num_logical
+        self.S = self.P // num_ranks
+        self.rank = np.arange(self.P) // self.S
+        self.bm, self.wb, self.wa = block_m, wb, wa
+        self.nr, self.nr_cold, self.hop2_rounds = rounds, cold_rounds, hop2_rounds
+        self.last_rounds = 0
+        self.slack = wb + block_m + wa
+        self.active = np.ones(self.P, bool)
+        self.slot_of = np.zeros(self.E, np.int64)
+        copies = {}
+        for e in range(self.E):
+            seen, act = set(), []
+            for s in np.nonzero(phy == e)[0]:
+                r = int(self.rank[s])
+                if r in seen:
+                    self.active[s] = False
+                    continue
+                seen.add(r)
+                act.append(int(s))
+            copies[e] = act
+            self.slot_of[e] = act[0] if act else -1
+        self.copies = {e: cs for e, cs in copies.items() if len(cs) > 1}
+
+    # ---- costs -------------------------------------------------------------------------------------------------
+    def rank_time(self, q):
+        q = np.asarray(q, np.int64)
+        return np.bincount(self.rank, self.wb * (-(-q // self.bm)) + self.wa * (q > 0) + q, self.R).astype(np.int64)
+
+    def _cost(self, s, y, hp):
+        blk = y + hp
+        return self.wb * blk + (self.wa if blk > 0 else 0) + y * self.bm + hp * self.rem[self.phy[s]]
+
+    def _has_unit(self, s):
+        return self.y[s] > 0 or self.part[self.phy[s]] == s
+
+    def _out(self, s):  # time change of rank(s) when one unit (the partial if s owns it) leaves s
+        y, hp = int(self.y[s]), int(self.part[self.phy[s]] == s)
+        if hp:
+            return self._cost(s, y, 0) - self._cost(s, y, 1), 1
+        return self._cost(s, y - 1, 0) - self._cost(s, y, 0), 0
+
+    def _in(self, s, ispart):  # time change of rank(s) when one unit of type `ispart` enters s
+        y, hp = int(self.y[s]), int(self.part[self.phy[s]] == s)
+        return self._cost(s, y + (0 if ispart else 1), hp + ispart) - self._cost(s, y, hp)
+
+    def _move(self, a, b, ispart):  # the partial unit (a must own it) or one full unit from slot a to slot b
+        e = self.phy[a]
+        if ispart:
+            assert self.part[e] == a
+            self.part[e] = b
+        else:
+            assert self.y[a] > 0
+            self.y[a] -= 1
+            self.y[b] += 1
+
+    def quota(self):
+        q = self.y * self.bm
+        m = self.part >= 0
+        q[self.part[m]] += self.rem[m]
+        return q
+
+    # ---- plan --------------------------------------------------------------------------------------------------
+    def plan(self, n, prev=None):
+        """Quota per physical slot for logical counts `n`; `prev` = (previous quotas, previous counts) or None."""
+        n = np.asarray(n, np.int64)
+        bm = self.bm
+        self.n = n
+        self.k = -(-n // bm)
+        self.rem = n - (self.k - 1) * bm
+        self.y = np.zeros(self.P, np.int64)
+        self.part = np.full(self.E, -1, np.int64)
+        for e in np.nonzero(n > 0)[0]:
+            if int(e) not in self.copies:
+                s0 = int(self.slot_of[e])
+                self.y[s0] = self.k[e] - 1
+                self.part[e] = s0
+        if prev is None or int(np.asarray(prev[1]).sum()) == 0:
+            self._cold(n)
+            return self._rounds(self.nr_cold)
+        self._warm(n, np.asarray(prev[0], np.int64), np.asarray(prev[1], np.int64))
+        return self._rounds(self.nr)
+
+    def _cold(self, n):   # even split, then round up the copies with the smallest (rank time * bm - leftover * (wb + bm))
+        bm = self.bm
+        x = np.zeros(self.P, np.int64)
+        for e in range(self.E):
+            if e not in self.copies and self.slot_of[e] >= 0:
+                x[self.slot_of[e]] = n[e]
+        for e, cs in self.copies.items():
+            tot, k = int(n[e]), len(cs)
+            x[cs] = tot // k
+            x[cs[0]] += tot - (tot // k) * k
+        t0 = self.rank_time(x)
+        for e, cs in self.copies.items():
+            if n[e] == 0:
+                continue
+            g = [int(x[s]) // bm for s in cs]
+            left = int(self.k[e]) - sum(g)
+            order = sorted(range(len(cs)), key=lambda j: (int(t0[self.rank[cs[j]]]) * bm - (int(x[cs[j]]) % bm) * (self.wb + bm), j))
+            for i in range(left):
+                g[order[i]] += 1
+            jp = max((j for j in range(len(cs)) if g[j] > 0), key=lambda j: (g[j] * bm - int(x[cs[j]]), -j))
+            for j, s in enumerate(cs):
+                self.y[s] = g[j] - (j == jp)
+            self.part[e] = cs[jp]
+
+    def _warm(self, n, qp, npv):
+        bm, unit = self.bm, self.wb + self.bm
+        keep = {}
+        for e, cs in self.copies.items():
+            if n[e] == 0:
+                continue
+            kp = -(-int(npv[e]) // bm)
+            u, own = [0] * len(cs), -1
+            if kp > 0:
+                remp = int(npv[e]) - (kp - 1) * bm
+                qs = [int(qp[s]) for s in cs]
+                own = next((j for j in range(len(cs)) if qs[j] >= remp and (qs[j] - remp) % bm == 0), -1)
+                if own >= 0:   # else an inconsistent previous plan: dropped for this expert
+                    u = [(qs[j] - (remp if j == own else 0)) // bm + (j == own) for j in range(len(cs))]
+            keep[e] = (u, own)
+        # estimate: kept units, new partial sizes (unit count changes not yet applied)
+        y0, part0 = self.y.copy(), self.part.copy()
+        for e, (u, own) in keep.items():
+            cs = self.copies[e]
+            if own >= 0:
+                for j, s in enumerate(cs):
